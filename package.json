{
  "name": "@munstar0s/pishora",
  "version": "0.1.0",
  "description": "Multi-model deliberation (OpenRouter fusion-style) as a native pi coding-agent extension",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-agent",
    "pi-coding-agent",
    "extension",
    "openrouter",
    "openrouter fusion",
    "fusion",
    "multi-model",
    "deliberation",
    "fusion harness",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "author": "Munstar0s",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Munstar0s/PiShora.git"
  },
  "homepage": "https://github.com/Munstar0s/PiShora#readme",
  "bugs": {
    "url": "https://github.com/Munstar0s/PiShora/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit --skipLibCheck --module esnext --moduleResolution bundler --target es2022 src/index.ts",
    "prepublishOnly": "npm run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@types/node": "^26.2.0",
    "jiti": "^2.7.0",
    "typebox": "^1.3.18",
    "typescript": "^7.0.2"
  }
}
